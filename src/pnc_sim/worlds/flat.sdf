<?xml version="1.0"?>
<!--
  Minimal flat world: ground plane, sun, the Ackermann car at the origin
  heading +x, and a painted ring that marks the default reference path
  (circle of radius 3 m centred at (0, 3), see pnc_bringup/config/control.yaml).

  Kept deliberately light: no sensors, no shadows, so it runs on an integrated
  GPU and in server-only (headless) mode.
-->
<sdf version="1.9">
  <world name="flat">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.8 0.9 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Visual-only ring (no collision): a white disk with a ground-coloured
         disk on top leaves a 6 cm wide line at R = 3 m. -->
    <model name="reference_circle">
      <static>true</static>
      <pose>0 3 0 0 0 0</pose>
      <link name="link">
        <visual name="line">
          <pose>0 0 0.001 0 0 0</pose>
          <geometry><cylinder><radius>3.03</radius><length>0.002</length></cylinder></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="inside">
          <pose>0 0 0.002 0 0 0</pose>
          <geometry><cylinder><radius>2.97</radius><length>0.002</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Rear-axle centre at the origin, axle height = wheel radius. -->
    <include>
      <uri>model://ackermann_car</uri>
      <name>ackermann_car</name>
      <pose>0 0 0.052 0 0 0</pose>
    </include>
  </world>
</sdf>
