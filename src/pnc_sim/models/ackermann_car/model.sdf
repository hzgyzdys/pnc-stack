<?xml version="1.0"?>
<!--
  1:10 Ackermann car for Gazebo Harmonic.

  The model frame (and base_link) sits at the rear-axle centre, at axle height,
  which is the reference point of the kinematic bicycle model in pnc_core. So
  the ground-truth odometry published below is directly the controller's state.

  Dimensions match src/pnc_bringup/config/control.yaml:
    wheelbase 0.33 m, track 0.25 m, wheel radius 0.05 m, max steer 0.45 rad.

  Topics (Gazebo side, bridged to ROS by pnc_sim/config/bridge.yaml):
    /model/ackermann_car/cmd_vel     gz.msgs.Twist      in  (v, yaw rate)
    /model/ackermann_car/odometry    gz.msgs.Odometry   out (ground truth)
-->
<sdf version="1.9">
  <model name="ackermann_car">

    <!-- ===================== chassis ===================== -->
    <link name="base_link">
      <inertial>
        <pose>0.165 0 0.03 0 0 0</pose>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.00708</ixx><iyy>0.0342</iyy><izz>0.0404</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <pose>0.165 0 0.03 0 0 0</pose>
        <geometry><box><size>0.45 0.20 0.05</size></box></geometry>
      </collision>
      <visual name="chassis_visual">
        <pose>0.165 0 0.03 0 0 0</pose>
        <geometry><box><size>0.45 0.20 0.05</size></box></geometry>
        <material>
          <ambient>0.1 0.3 0.8 1</ambient>
          <diffuse>0.1 0.3 0.8 1</diffuse>
        </material>
      </visual>
      <!-- Small marker on the nose so the heading is easy to see. -->
      <visual name="nose_visual">
        <pose>0.36 0 0.06 0 0 0</pose>
        <geometry><box><size>0.04 0.16 0.01</size></box></geometry>
        <material>
          <ambient>0.9 0.9 0.1 1</ambient>
          <diffuse>0.9 0.9 0.1 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- ===================== rear wheels (driven) ===================== -->
    <link name="rear_left_wheel">
      <pose>0 0.125 0 -1.5707963 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.000152</ixx><iyy>0.000152</iyy><izz>0.00025</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.05</radius><length>0.04</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.05</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>

    <link name="rear_right_wheel">
      <pose>0 -0.125 0 -1.5707963 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.000152</ixx><iyy>0.000152</iyy><izz>0.00025</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.05</radius><length>0.04</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.05</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>

    <!-- ===================== front steering knuckles ===================== -->
    <link name="front_left_steering_link">
      <pose>0.33 0.125 0 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
    </link>

    <link name="front_right_steering_link">
      <pose>0.33 -0.125 0 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
    </link>

    <!-- ===================== front wheels ===================== -->
    <link name="front_left_wheel">
      <pose>0.33 0.125 0 -1.5707963 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.000152</ixx><iyy>0.000152</iyy><izz>0.00025</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.05</radius><length>0.04</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.05</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>

    <link name="front_right_wheel">
      <pose>0.33 -0.125 0 -1.5707963 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.000152</ixx><iyy>0.000152</iyy><izz>0.00025</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.05</radius><length>0.04</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.05</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>

    <!-- ===================== joints ===================== -->
    <!-- Wheel axes are the wheel link's z axis, which points along +y of the
         car after the -90 deg roll, so a positive joint speed drives forward. -->
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_left_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_right_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <joint name="front_left_steering_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_left_steering_link</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.6</lower><upper>0.6</upper><effort>1e6</effort></limit></axis>
    </joint>

    <joint name="front_right_steering_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_right_steering_link</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.6</lower><upper>0.6</upper><effort>1e6</effort></limit></axis>
    </joint>

    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_steering_link</parent>
      <child>front_left_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_steering_link</parent>
      <child>front_right_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- ===================== plugins ===================== -->
    <!-- Converts a Twist (v, yaw rate) into wheel speeds and Ackermann
         steering angles, using delta = atan(L * omega / v). -->
    <plugin filename="gz-sim-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">
      <!-- Rear-wheel drive; the front wheels roll freely. -->
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>
      <kingpin_width>0.25</kingpin_width>
      <steering_limit>0.45</steering_limit>
      <steer_p_gain>10.0</steer_p_gain>
      <wheel_base>0.33</wheel_base>
      <wheel_separation>0.25</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <min_velocity>-2.0</min_velocity>
      <max_velocity>2.0</max_velocity>
      <min_acceleration>-3.0</min_acceleration>
      <max_acceleration>2.0</max_acceleration>
      <topic>/model/ackermann_car/cmd_vel</topic>
      <!-- Wheel-encoder odometry is kept on its own topic; the stack uses the
           ground-truth odometry from OdometryPublisher instead. -->
      <odom_topic>/model/ackermann_car/wheel_odometry</odom_topic>
      <tf_topic>/model/ackermann_car/wheel_tf</tf_topic>
    </plugin>

    <!-- Ground-truth pose and body-frame velocity of the model frame
         (rear-axle centre). -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/model/ackermann_car/odometry</odom_topic>
      <tf_topic>/model/ackermann_car/pose</tf_topic>
      <dimensions>2</dimensions>
    </plugin>

  </model>
</sdf>
